#Entorno
DEBUG=True

SECRET_KEY="KEY DE TRABAJANDO DE DJANGO"

DATABASE_URL="RUTA PARA CONEXIÓN A BASE DE DATOS"

ALLOWED_HOSTS=localhost,127.0.0.1

# Redis para cache y códigos temporales
REDIS_URL=redis://localhost:6379/0

# Email / SMTP 
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password
DEFAULT_FROM_EMAIL=tu_email@gmail.com

# CORS (opcional, comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# CORS credentials si realmente se usan cookies (False si usas JWT en headers)
CORS_ALLOW_CREDENTIALS=True

# DB connection tweaks (opcional)
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False

# Throttles (opcional)
THROTTLE_USER=1000/day
THROTTLE_ANON=100/day
THROTTLE_VERIFY_EMAIL=3/min

# JWT settings (opcional)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# Production security overrides (solo cuando DEBUG=False)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=

# Logging
LOG_LEVEL=INFO
RECAPTCHA_SECRET_KEY="CAPTCHA KEY"

# -------------------------
# MinIO / S3 Object Storage
# -------------------------
# Configuración para almacenamiento de imágenes con MinIO (S3-compatible)
# En desarrollo: usar MinIO local con Docker
# En producción: apuntar al servidor MinIO de producción

# Endpoint del servidor MinIO (sin trailing slash)
MINIO_ENDPOINT=http://localhost:9000

# Credenciales de acceso (usar las del docker-compose.minio.yml en desarrollo)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Nombre del bucket para archivos de media (imágenes de perfil)
MINIO_BUCKET_NAME=cupido-media

# Usar SSL/TLS (True para producción con HTTPS)
MINIO_USE_SSL=False

# Región (opcional, dejar vacío si no aplica)
MINIO_REGION=

# URL pública para servir archivos (puede ser diferente al endpoint interno)
# En producción podría ser un CDN o dominio público del MinIO
MINIO_PUBLIC_URL=http://localhost:9000

# -------------------------
# Límites de carga de fotos
# -------------------------
# Tamaño máximo permitido en bytes (400KB por defecto)
# Las imágenes se comprimen automáticamente si exceden este límite
PHOTO_MAX_UPLOAD_SIZE=409600

# Número máximo de fotos por usuario
PHOTO_MAX_FILES=3

# -------------------------
# Sightengine - Moderación de Contenido
# -------------------------
# API para detectar contenido inapropiado en fotos (desnudez, armas, drogas, violencia)
# Registrarse en: https://sightengine.com/
# Si no se configura, las fotos se aceptan sin moderación
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=